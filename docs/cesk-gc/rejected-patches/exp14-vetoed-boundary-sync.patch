+fn inner_shadow_debug_epoch_check() {
+    let current_epoch = crate::backend::models::gc_allocator::gc_sweep_epoch();
+    INNER_SHADOW_EPOCH.with(|epoch| {
+        if epoch.get() != current_epoch {
+            let occupied =
