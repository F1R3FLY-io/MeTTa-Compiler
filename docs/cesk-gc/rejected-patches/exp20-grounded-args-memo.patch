+/// exp20: the grounded-args memo key — FNV-1a over each item's CONTENT hash
+/// (`hash_value()`, cached per value). Content keys are ABA-immune (Addr/word
+/// reuse cannot alias a different expression onto a live key).
+fn grounded_args_memo_key<V: MettaValueTrait>(items: &[V]) -> u64 {
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    for it in items {
+        let v = it.hash_value();
+        for b in v.to_le_bytes() {
+            h ^= b as u64;
+            h = h.wrapping_mul(0x0000_0100_0000_01b3);
+        }
+    }
+    h
+}
