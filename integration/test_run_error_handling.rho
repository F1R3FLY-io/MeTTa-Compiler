// =====================================================================
// MeTTa .run() Error Handling Tests
// =====================================================================
// Tests type-discriminated return values from .run()
// Success → PathMap (matches {| ..._ |})
// Failure → EList [error_code, message] (does NOT match PathMap pattern)
//
// Error paths in reduce.rs .run() method:
//   1. invalid_accumulated_state — accumulated PathMap can't be deserialized
//      (tested by Test 2: {| true |}.run(validCompiled))
//   2. invalid_compiled_state — compiled PathMap can't be deserialized
//      (tested by Test 4: {||}.run({| "not a state" |}))
//   3. evaluation_failed — MeTTa runtime error from run_state_async()
//      (not testable from Rholang: requires internal MeTTa runtime failure)
//   4. extraction_failed — metta_state_to_pathmap_par() produces non-PathMap
//      (not testable from Rholang: defensive code for unreachable case)
// =====================================================================

new stdoutAck(`rho:io:stdoutAck`),
    mettaCompile(`rho:metta:compile`),
    runTest,
    testComplete,
    waitForTests,
    ack in {

  // ===================================================================
  // Test Completion Counter - Waits for all 5 tests before printing summary
  // ===================================================================

  contract waitForTests(@count, summaryCh) = {
    if (count == 5) {
      summaryCh!(Nil)
    } else {
      for (_ <- testComplete) {
        waitForTests!(count + 1, *summaryCh)
      }
    }
  } |

  // ===================================================================
  // Test Suite: .run() Error Handling
  // ===================================================================

  stdoutAck!("=== MeTTa Run Error Handling Test Suite ===\n\n", *ack) |

  // Trigger all tests
  for (_ <- ack) {
    new ret1, ret2, ret3, ret4, ret5 in {
      runTest!(*ret1, "1") |
      runTest!(*ret2, "2") |
      runTest!(*ret3, "3") |
      runTest!(*ret4, "4") |
      runTest!(*ret5, "5")
    }
  } |

  // -------------------------------------------------------------------
  // Test 1: .run() success returns PathMap
  // -------------------------------------------------------------------
  for (ret, @"1" <- runTest) {
    stdoutAck!("Test 1: .run() success returns PathMap\n", *ack) |
    for (_ <- ack) {
      new compiledState, result in {
        mettaCompile!(*compiledState, "!(+ 1 2)") |
        for (@pm <- compiledState) {
          result!({||}.run(pm)) |
          for (@rslt <- result) {
            match rslt {
              {| ..._ |} => {
                stdoutAck!("  PASS: Result is PathMap\n", *ack) |
                for (_ <- ack) {
                  stdoutAck!("  Result: ", *ack) |
                  for (_ <- ack) {
                    stdoutAck!(rslt, *ack) |
                    for (_ <- ack) {
                      stdoutAck!("\n\n", *ack) |
                      for (_ <- ack) {
                        ret!() | testComplete!("1")
                      }
                    }
                  }
                }
              }
              other => {
                stdoutAck!("  UNEXPECTED: Result is not PathMap: ", *ack) |
                for (_ <- ack) {
                  stdoutAck!(other, *ack) |
                  for (_ <- ack) {
                    stdoutAck!("\n\n", *ack) |
                    for (_ <- ack) {
                      ret!() | testComplete!("1")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // -------------------------------------------------------------------
  // Test 2: .run() with invalid receiver returns error list
  // Error path: invalid_accumulated_state
  // {| true |} is not a valid MettaState, should get error list
  // -------------------------------------------------------------------
  for (ret, @"2" <- runTest) {
    stdoutAck!("Test 2: .run() with invalid receiver {| true |} returns error list\n", *ack) |
    for (_ <- ack) {
      new compiledState, result in {
        mettaCompile!(*compiledState, "!(+ 1 2)") |
        for (@pm <- compiledState) {
          result!({| true |}.run(pm)) |
          for (@rslt <- result) {
            match rslt {
              {| ..._ |} => {
                stdoutAck!("  UNEXPECTED: Got PathMap for invalid receiver\n\n", *ack) |
                for (_ <- ack) {
                  ret!() | testComplete!("2")
                }
              }
              [code, msg] => {
                stdoutAck!("  PASS: Got error list\n", *ack) |
                for (_ <- ack) {
                  stdoutAck!("  Error code: ", *ack) |
                  for (_ <- ack) {
                    stdoutAck!(code, *ack) |
                    for (_ <- ack) {
                      stdoutAck!("\n  Message: ", *ack) |
                      for (_ <- ack) {
                        stdoutAck!(msg, *ack) |
                        for (_ <- ack) {
                          stdoutAck!("\n\n", *ack) |
                          for (_ <- ack) {
                            ret!() | testComplete!("2")
                          }
                        }
                      }
                    }
                  }
                }
              }
              other => {
                stdoutAck!("  OTHER: ", *ack) |
                for (_ <- ack) {
                  stdoutAck!(other, *ack) |
                  for (_ <- ack) {
                    stdoutAck!("\n\n", *ack) |
                    for (_ <- ack) {
                      ret!() | testComplete!("2")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // -------------------------------------------------------------------
  // Test 3: .run() chaining - compile, run, then run again
  // Tests that .run() success path still works for sequential evaluation
  // -------------------------------------------------------------------
  for (ret, @"3" <- runTest) {
    stdoutAck!("Test 3: .run() chaining - sequential evaluation\n", *ack) |
    for (_ <- ack) {
      new c1, c2, r1, r2 in {
        // Step 1: Compile and run a rule definition
        mettaCompile!(*c1, "(= (double $x) (* $x 2))") |
        for (@compiled1 <- c1) {
          r1!({||}.run(compiled1)) |
          for (@state1 <- r1) {
            stdoutAck!("  Step 1: Defined double rule\n", *ack) |
            for (_ <- ack) {
              // Step 2: Compile evaluation and run against accumulated state
              mettaCompile!(*c2, "!(double 7)") |
              for (@compiled2 <- c2) {
                r2!(state1.run(compiled2)) |
                for (@state2 <- r2) {
                  match state2 {
                    {| ..._ |} => {
                      stdoutAck!("  Step 2: PASS - Evaluated double(7)\n", *ack) |
                      for (_ <- ack) {
                        stdoutAck!("  Result: ", *ack) |
                        for (_ <- ack) {
                          stdoutAck!(state2, *ack) |
                          for (_ <- ack) {
                            stdoutAck!("\n  Expected: output [14]\n\n", *ack) |
                            for (_ <- ack) {
                              ret!() | testComplete!("3")
                            }
                          }
                        }
                      }
                    }
                    [code, msg] => {
                      stdoutAck!("  Step 2: UNEXPECTED error: ", *ack) |
                      for (_ <- ack) {
                        stdoutAck!(code, *ack) |
                        for (_ <- ack) {
                          stdoutAck!(" - ", *ack) |
                          for (_ <- ack) {
                            stdoutAck!(msg, *ack) |
                            for (_ <- ack) {
                              stdoutAck!("\n\n", *ack) |
                              for (_ <- ack) {
                                ret!() | testComplete!("3")
                              }
                            }
                          }
                        }
                      }
                    }
                    other => {
                      stdoutAck!("  Step 2: OTHER: ", *ack) |
                      for (_ <- ack) {
                        stdoutAck!(other, *ack) |
                        for (_ <- ack) {
                          stdoutAck!("\n\n", *ack) |
                          for (_ <- ack) {
                            ret!() | testComplete!("3")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // -------------------------------------------------------------------
  // Test 4: .run() with invalid compiled state returns error list
  // Error path: invalid_compiled_state
  // {||}.run({| "not a state" |}) — valid empty receiver, invalid compiled arg
  // The compiled argument {| "not a state" |} cannot be deserialized by
  // pathmap_par_to_metta_state() (strict), triggering invalid_compiled_state
  // -------------------------------------------------------------------
  for (ret, @"4" <- runTest) {
    stdoutAck!("Test 4: .run() with invalid compiled state returns error list\n", *ack) |
    for (_ <- ack) {
      new result in {
        result!({||}.run({| "not a state" |})) |
        for (@rslt <- result) {
          match rslt {
            {| ..._ |} => {
              stdoutAck!("  UNEXPECTED: Got PathMap for invalid compiled state\n\n", *ack) |
              for (_ <- ack) {
                ret!() | testComplete!("4")
              }
            }
            [code, msg] => {
              stdoutAck!("  PASS: Got error list for invalid compiled state\n", *ack) |
              for (_ <- ack) {
                stdoutAck!("  Error code: ", *ack) |
                for (_ <- ack) {
                  stdoutAck!(code, *ack) |
                  for (_ <- ack) {
                    stdoutAck!("\n  Message: ", *ack) |
                    for (_ <- ack) {
                      stdoutAck!(msg, *ack) |
                      for (_ <- ack) {
                        stdoutAck!("\n\n", *ack) |
                        for (_ <- ack) {
                          ret!() | testComplete!("4")
                        }
                      }
                    }
                  }
                }
              }
            }
            other => {
              stdoutAck!("  OTHER: ", *ack) |
              for (_ <- ack) {
                stdoutAck!(other, *ack) |
                for (_ <- ack) {
                  stdoutAck!("\n\n", *ack) |
                  for (_ <- ack) {
                    ret!() | testComplete!("4")
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // -------------------------------------------------------------------
  // Test 5: .run() with both invalid receiver AND invalid compiled state
  // Error path: invalid_accumulated_state (triggered first)
  // {| 42 |}.run({| "bad" |}) — both are invalid, but accumulated is
  // checked first, so we expect invalid_accumulated_state
  // -------------------------------------------------------------------
  for (ret, @"5" <- runTest) {
    stdoutAck!("Test 5: .run() with both args invalid returns accumulated error first\n", *ack) |
    for (_ <- ack) {
      new result in {
        result!({| 42 |}.run({| "bad" |})) |
        for (@rslt <- result) {
          match rslt {
            {| ..._ |} => {
              stdoutAck!("  UNEXPECTED: Got PathMap for doubly-invalid .run()\n\n", *ack) |
              for (_ <- ack) {
                ret!() | testComplete!("5")
              }
            }
            [code, msg] => {
              stdoutAck!("  PASS: Got error list for doubly-invalid .run()\n", *ack) |
              for (_ <- ack) {
                stdoutAck!("  Error code: ", *ack) |
                for (_ <- ack) {
                  stdoutAck!(code, *ack) |
                  for (_ <- ack) {
                    stdoutAck!("\n  Message: ", *ack) |
                    for (_ <- ack) {
                      stdoutAck!(msg, *ack) |
                      for (_ <- ack) {
                        stdoutAck!("\n\n", *ack) |
                        for (_ <- ack) {
                          ret!() | testComplete!("5")
                        }
                      }
                    }
                  }
                }
              }
            }
            other => {
              stdoutAck!("  OTHER: ", *ack) |
              for (_ <- ack) {
                stdoutAck!(other, *ack) |
                for (_ <- ack) {
                  stdoutAck!("\n\n", *ack) |
                  for (_ <- ack) {
                    ret!() | testComplete!("5")
                  }
                }
              }
            }
          }
        }
      }
    }
  } |

  // Start the test completion counter
  new summaryCh in {
    waitForTests!(0, *summaryCh) |

    // Final Summary - Wait for all tests to complete before printing
    for (_ <- summaryCh) {
      stdoutAck!("\n=== Run Error Handling Test Suite Complete ===\n", *ack) |
      for (_ <- ack) {
        stdoutAck!("All 5 tests completed:\n", *ack) |
        for (_ <- ack) {
          stdoutAck!("  - .run() success returns PathMap\n", *ack) |
          for (_ <- ack) {
            stdoutAck!("  - .run() invalid receiver returns error list (invalid_accumulated_state)\n", *ack) |
            for (_ <- ack) {
              stdoutAck!("  - .run() chaining works\n", *ack) |
              for (_ <- ack) {
                stdoutAck!("  - .run() invalid compiled state returns error list (invalid_compiled_state)\n", *ack) |
                for (_ <- ack) {
                  stdoutAck!("  - .run() both args invalid returns accumulated error first\n", *ack)
                }
              }
            }
          }
        }
      }
    }
  }
}
